# ──────────────────────────────────────────────────────────────────────────────
# LLM Gateway V7 — Environment Configuration
# Copy this to .env (same directory) and fill in real values.
# ──────────────────────────────────────────────────────────────────────────────

# ── Gemini API Keys (5-key rotation ring) ─────────────────────────────────────
# Set all 5 for maximum rate-limit resilience. The gateway rotates to the
# next key automatically on 429 / 403 quota errors (both LLM and embedding).
GEMINI_API_KEY_1=your-gemini-api-key-1-here
GEMINI_API_KEY_2=your-gemini-api-key-2-here
GEMINI_API_KEY_3=your-gemini-api-key-3-here
GEMINI_API_KEY_4=your-gemini-api-key-4-here
GEMINI_API_KEY_5=your-gemini-api-key-5-here

# Model cascade order — tried cheapest-first, advances on quota/model errors.
# Override to change the order or limit which models are tried.
GEMINI_MODEL_ORDER=gemini-2.5-flash-lite-preview-06-17,gemini-2.5-flash-lite,gemini-2.0-flash-lite,gemini-2.5-flash

# ── Ollama (local, primary — no API key needed) ────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Embedding model — FIXED after first index build. Changing this invalidates
# every FAISS index. Both Ollama nomic-embed-text and Gemini gemini-embedding-001
# output 768-dim vectors so you can fall over without breaking the index.
EMBED_OLLAMA_MODEL=nomic-embed-text
EMBED_FALLBACK_PROVIDER=gemini
EMBED_FALLBACK_MODEL=gemini-embedding-001

# ── Optional cloud providers ───────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

CEREBRAS_API_KEY=
CEREBRAS_MODEL=zai-glm-4.7

NVIDIA_API_KEY=
NVIDIA_MODEL=deepseek-ai/deepseek-v3.2

OPEN_ROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

GITHUB_ACCESS_TOKEN=
GITHUB_MODEL=openai/gpt-4.1-mini

# ── Gateway port ───────────────────────────────────────────────────────────────
GATEWAY_V7_PORT=8107

# ── Provider order (comma-separated, fallover left to right) ──────────────────
LLM_ORDER=ollama,gemini,nvidia,groq,cerebras,openrouter,github
ROUTER_ORDER=cerebras,groq,nvidia,github
